<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window theme only (shown before Compose draws). The app UI is themed by ZuzuTheme (Material 3)
      in Kotlin, so no AppCompat / Material Components (Views) dependency is needed.
    -->
    <style name="Theme.Zuzu" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zuzu_midnight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Launch theme for MainActivity (androidx.core:core-splashscreen). installSplashScreen()
      swaps to postSplashScreenTheme as soon as the activity starts; no artificial delay.
      Android 12+ adds the wordmark through values-v31/themes.xml.
    -->
    <style name="Theme.Zuzu.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zuzu_midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mascot_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Zuzu</item>
    </style>
</resources>
