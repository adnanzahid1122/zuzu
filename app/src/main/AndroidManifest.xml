<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required: :tunnel's manifest declares only the VpnService; wireguard-go opens UDP sockets. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zuzu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Zuzu.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          No <service> declaration here on purpose:
          com.wireguard.android.backend.GoBackend$VpnService (BIND_VPN_SERVICE, android.net.VpnService
          intent filter) is merged in from tunnel/src/main/AndroidManifest.xml.
        -->
    </application>
</manifest>
